# ── Option A: AI Studio (default, simplest) ───────────────────────────────
# Free key from https://aistudio.google.com/apikey
# Free tier is capped at 20 requests per day PER MODEL, so attach billing
# before a live demo. The app falls back across five distinct models.
GEMINI_API_KEY=

# Optional: force one model instead of the built-in fallback chain.
# GEMINI_MODEL=gemini-3.7-flash


# ── Option B: Vertex AI (same Gemini models, Google Cloud billing) ────────
# Use this if the project sits on Google Cloud credits — GenAI App Builder /
# Agent Builder credits apply to Vertex, not to AI Studio keys.
# Requires the Vertex AI API enabled on the project.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Service account JSON, as a single line. Needed on serverless hosts such as
# Vercel, where there is no metadata server to supply default credentials.
# The account needs the "Vertex AI User" role.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Vertex publishes a different model set from AI Studio. Comma separated,
# tried in order.
# VERTEX_MODELS=gemini-2.5-flash,gemini-2.0-flash


# ── Text to speech ────────────────────────────────────────────────────────
# TTS stays on the AI Studio key by default even when Vertex is enabled,
# because the preview TTS models are not published in every Vertex region.
# Set this to route TTS through Vertex as well.
# GEMINI_TTS_USE_VERTEX=true

# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE_UR=Kore
# GEMINI_TTS_VOICE_EN=Charon
